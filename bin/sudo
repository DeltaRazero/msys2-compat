#!/usr/bin/bash

# Wrapper script for running commands with elevated privileges in a MSYS2 shell
# using a sudo provider such as Microsoft Sudo on Windows or gerardog's gsudo.

# msys2-compat
# Copyright (C) 2026 DeltaRazero
#
# This program is free software: you can redistribute it and/or modify
# it under the terms of the GNU General Public License as published by
# the Free Software Foundation, either version 3 of the License, or
# (at your option) any later version.
#
# This program is distributed in the hope that it will be useful,
# but WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
# GNU General Public License for more details.
#
# You should have received a copy of the GNU General Public License
# along with this program.  If not, see <https://www.gnu.org/licenses/>.

VERSION='1.0.0'
PROGRAM=${0##*/}

warn() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
}

die() {
  warn "$@"
  exit 1
}

show_help() {
  cat <<'EOF'
Usage: sudo [OPTIONS] [--] COMMAND [ARG ...]
       sudo [OPTIONS]

Run COMMAND in an elevated MSYS2 shell. With no COMMAND, open an interactive
shell. Arguments are preserved literally, including spaces, quotes and
backslashes.

Options:
  -i, --login           Start the shell as a login shell.
  -s, --shell           Start an interactive shell (also with COMMAND).
  -u, --user USER       Run as USER.
  -E, --preserve-env    Ask sudo to copy the caller's environment.
      --help            Show this help.
      --version         Show version information.

gsudo-specific options:
      --copy-network-drives
                        Connect network drives to the elevated user.

Provider selection:
  By default, prefers the sudo provider that aliases `sudo.exe` first in PATH,
  which is likely Microsoft Sudo on Windows.
  Set MSYS_SUDO_PROVIDER=gsudo or MSYS_SUDO_PROVIDER=windows to force provider.

EOF
  exit 0
}

show_version() {
  printf '%s %s\n' "$PROGRAM" "$VERSION"
  exit 0
}

command -v cmd.exe >/dev/null 2>&1 || die 'cmd.exe was not found'
command -v cygpath >/dev/null 2>&1 || die 'cygpath was not found'

# ******************************************************************************
#  GLOBALS
# ******************************************************************************

SUDO_PROVIDER_PREFERENCE=${MSYS_SUDO_PROVIDER:-auto}

SUDO_PROVIDER_WINDOWS=0
SUDO_PROVIDER_GSUDO=1

_prepare_sudo_provider() {
  local regex
  # Microsoft's Sudo for Windows.
  for p in 'auto' 'windows'; do
    regex='.*sudo [0-9]+\.[0-9]+\.[0-9].*'
    [[ $SUDO_PROVIDER_PREFERENCE == $p && `sudo.exe --version 2>&1` =~ $regex ]] && return $SUDO_PROVIDER_WINDOWS
  done
  # Gerardo Grignoli's gsudo.
  for p in 'auto' 'gsudo'; do
    regex='.*sudo [0-9]+\.[0-9]+\.[0-9].*'
    [[ $SUDO_PROVIDER_PREFERENCE == $p && `gsudo.exe --version 2>&1` =~ $regex ]] && return $SUDO_PROVIDER_GSUDO
  done
  die 'no suitable sudo provider available'
}
_prepare_sudo_provider
SUDO_PROVIDER=$?

SHELL_PATH=`cygpath -w -- "$SHELL"`
SHELL_NAME="${SHELL##*/}"

# ******************************************************************************
#  ARGUMENT PARSER
# ******************************************************************************

preserve_env=0
copy_network_drives=0
runas_user=''

login_shell=0
interactive_shell=0

user_command=''

_execute_sudo=0
while [[ $# -gt 0 ]]; do
  arg=$1
  # Break when user command should be processed.
  [[ ! $1 == -* ]] && break
  shift
  case $arg in
    --help|-h)
      show_help
      ;;
    --version)
      show_version
      ;;
    --login|-i)
      _execute_sudo=1
      interactive_shell=0
      login_shell=1
      ;;
    --shell|-s)
      _execute_sudo=1
      interactive_shell=1
      login_shell=0
      ;;
    --preserve-env|-E)
      preserve_env=1
      ;;
    --copy-network-drives|--copyns)
      copy_network_drives=1
      ;;
    --user)
      _execute_sudo=1
      (($#)) || die "option '--user' requires an argument"
      (( SUDO_PROVIDER == SUDO_PROVIDER_WINDOWS )) && die "option '--user' is not supported with Microsoft Sudo on Windows"
      runas_user=$1
      shift
      ;;
    --user=*)
      _execute_sudo=1
      runas_user=${arg#*=}
      [[ -n $runas_user ]] || die "option '--user' requires an argument"
      (( SUDO_PROVIDER == SUDO_PROVIDER_WINDOWS )) && die "option '--user' is not supported with Microsoft Sudo on Windows"
      ;;
    --)
      break
      ;;
    -[!-]*)
      # Support clusters such as -is and -uAdministrator.
      cluster=${arg#-}
      while [[ -n $cluster ]]; do
        option=${cluster:0:1}
        cluster=${cluster:1}
        case $option in
          i)
            _execute_sudo=1
            login_shell=1
            ;;
          s)
            _execute_sudo=1
            interactive_shell=1
            ;;
          E)
            preserve_env=1
            ;;
          u)
            _execute_sudo=1
            (( SUDO_PROVIDER == SUDO_PROVIDER_WINDOWS )) && die "option '-u' is not supported with Microsoft Sudo on Windows"
            if [[ -n $cluster ]]; then
              runas_user=$cluster
              cluster=''
            else
              (($#)) || die "option '-u' requires an argument"
              runas_user=$1
              shift
            fi
            ;;
          *)
            die "invalid option -- '$option'"
            ;;
        esac
      done
      ;;
    -* )
      die "invalid option '$arg'"
      ;;
    *)
      break
      ;;
  esac
done

# Reconstruct the remaining arguments into a single string, ensuring spaces,
# quotes, and newlines are safely escaped/preserved.
(( $# )) && _execute_sudo=1 && user_command=$(printf '%q ' "$@")

# Exit if there's no action for sudo to execute.
(( _execute_sudo )) || exit 0

# ******************************************************************************

# Prepare the sudo command.
sudo_command=()
case $SUDO_PROVIDER in
  $SUDO_PROVIDER_WINDOWS)
    sudo_command+=('sudo.exe' '--inline')
    (( preserve_env )) && sudo_command+=('-E')
    ;;
  $SUDO_PROVIDER_GSUDO)
    sudo_command+=('gsudo.exe' '--direct')
    (( copy_network_drives )) && sudo_command+=('--copyns')
    (( preserve_env )) && sudo_command+=('--copyev')
    [[ ! -z $runas_user ]] && sudo_command+=("-u \"$runas_user\"")
    ;;
  *)
    die "sudo provider '$SUDO_PROVIDER' is not implemented yet"
    ;;
esac

shell_arguments=()
(( login_shell )) && shell_arguments+=('-l')
(( interactive_shell )) && shell_arguments+=('-i')
# This must be passed as last argument.
[[ ! -z "$user_command" ]] && shell_arguments+=("-c" "$user_command")

if (( preserve_env ));
  then ${sudo_command[@]} "$SHELL_PATH" "${shell_arguments[@]}"
  else ${sudo_command[@]} cmd //s //c set CHERE_INVOKING=1\&\&set MSYS2_PATH_TYPE=$MSYS2_PATH_TYPE\&\&set MSYSTEM=$MSYSTEM\&\&set MSYS=$MSYS\&\& "$SHELL_PATH" "${shell_arguments[@]}"
fi
