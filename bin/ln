#!/usr/bin/bash

# GNU ln-style link creation for MSYS2 using Windows' mklink command. The script
# intentionally keeps the filesystem/operand semantics of GNU ln where Windows
# can implement them, while using mklink to perform the actual link creation.

# msys2-compat
# Copyright (C) 2026 DeltaRazero
#
# This program is free software: you can redistribute it and/or modify
# it under the terms of the GNU General Public License as published by
# the Free Software Foundation, either version 3 of the License, or
# (at your option) any later version.
#
# This program is distributed in the hope that it will be useful,
# but WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
# GNU General Public License for more details.
#
# You should have received a copy of the GNU General Public License
# along with this program.  If not, see <https://www.gnu.org/licenses/>.

VERSION='1.0.0'
PROGRAM=${0##*/}

warn() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
}

die() {
  warn "$@"
  exit 1
}

show_help() {
  cat <<'EOF'
Usage: ln [OPTION]... [-T] TARGET LINK_NAME
  or:  ln [OPTION]... TARGET
  or:  ln [OPTION]... TARGET... DIRECTORY
  or:  ln [OPTION]... -t DIRECTORY TARGET...
In the 1st form, create a link to TARGET with the name LINK_NAME.
In the 2nd form, create a link to TARGET in the current directory.
In the 3rd and 4th forms, create links to each TARGET in DIRECTORY.
Create hard links by default, symbolic links with --symbolic.
By default, each destination (name of new link) should not already exist.
When creating hard links, each TARGET must exist.  Symbolic links
can hold arbitrary text; if later resolved, a relative link is
interpreted in relation to its parent directory.

Mandatory arguments to long options are mandatory for short options too.
      --backup[=CONTROL]      make a backup of each existing destination file
  -b                          like --backup but does not accept an argument
  -d, -F, --directory         not supported on Windows; allow the superuser to
                                attempt to hard link directories (note: will
                                probably fail due to system restrictions, even
                                for the superuser)
  -f, --force                 remove existing destination files
  -i, --interactive           prompt whether to remove destinations
  -L, --logical               dereference TARGETs that are symbolic links
  -n, --no-dereference        treat LINK_NAME as a normal file if
                                it is a symbolic link to a directory
  -P, --physical              make hard links directly to symbolic links
  -r, --relative              create symbolic links relative to link location
  -s, --symbolic              make symbolic links instead of hard links
  -S, --suffix=SUFFIX         override the usual backup suffix
  -t, --target-directory=DIRECTORY  specify the DIRECTORY in which to create
                                the links
  -T, --no-target-directory   treat LINK_NAME as a normal file always
  -v, --verbose               print name of each linked file
      --help     display this help and exit
      --version  output version information and exit

The backup suffix is '~', unless set with --suffix or SIMPLE_BACKUP_SUFFIX.
The version control method may be selected via the --backup option or through
the VERSION_CONTROL environment variable.  Here are the values:

  none, off       never make backups (even if --backup is given)
  numbered, t     make numbered backups
  existing, nil   numbered if numbered backups exist, simple otherwise
  simple, never   always make simple backups

Using -s ignores -L and -P.  Otherwise, the last option specified controls
behavior when a TARGET is a symbolic link, defaulting to -P.

GNU coreutils online help: <https://www.gnu.org/software/coreutils/>
Full documentation <https://www.gnu.org/software/coreutils/ln>
or available locally via: info '(coreutils) ln invocation'

EOF
  exit 0
}

show_version() {
  printf '%s %s\n' "$PROGRAM" "$VERSION"
  exit 0
}

command -v cmd.exe  >/dev/null 2>&1 || die 'cmd.exe was not found'
command -v cygpath  >/dev/null 2>&1 || die 'cygpath was not found'
command -v realpath >/dev/null 2>&1 || die 'realpath was not found'

# ******************************************************************************
#  HELPERS
# ******************************************************************************

# Converts a MSYS2/Cygwin path to a Windows path.
to_win_path() {
  local path=$1
  # Strip trailing whitespace (spaces and tabs). https://stackoverflow.com/a/3352015
  path="${path#"${path%%[![:space:]]*}"}"
  # Expand leading tilde to $HOME.
  [[ $path == \~/* ]] && path="${HOME}/${path#\~/}"
  if [[ $path == /* ]];
    # Only convert path if it starts as a UNIX path.
    then cygpath -w -- "$path"
    # Keep native Windows paths, UNC paths, and relative paths as-is, and ensure
    # backslashes are used.
    else printf '%s\n' "${path//\//\\}"
  fi
}

path_exists() {
  local path=`to_win_path "$1"`
  # -e is false for dangling symlinks; -L catches them.
  [[ -e $path || -L $path ]]
}

# ******************************************************************************
#  BACKUP
# ******************************************************************************

vc_default=${VERSION_CONTROL-existing}

backup_enabled=0
backup_control=$vc_default

backup_suffix=${SIMPLE_BACKUP_SUFFIX-~}
suffix=$backup_suffix

make_backup() {
  local dst=$1 backup_name

  case $backup_control in
    none|off)
      return 1
      ;;
    simple|never)
      backup_name="${dst}${suffix}"
      ;;
    numbered|t)
      local n=1
      while :; do
        backup_name="$dst.~${n}~"
        if ! path_exists "$backup_name"; then
          break
        fi
        ((n++))
      done
      ;;
    existing|nil|'')
      local n=1
      while path_exists "$dst.~${n}~"; do
        ((n++))
      done
      if (( numbered_found )); then
        ((n++))
        backup_name="$dst.~${n}~"
      else
        backup_name="${dst}${suffix}"
      fi
      ;;
    *)
      warn "invalid backup method '$backup_control'"
      return 1
      ;;
  esac

  if [[ $backup_name == "$dst" ]]; then
    warn "backup name for '$dst' is identical to the destination"
    return 1
  fi

  # -T prevents GNU mv from interpreting an existing backup directory as the
  # destination container; a backup name denotes one filesystem object.
  if ! mv -fT -- "$dst" "$backup_name" 2>/dev/null; then
    warn "cannot backup '$dst' as '$backup_name'"
    return 1
  fi
}

# ******************************************************************************
#  LINK CREATION
# ******************************************************************************

is_symbolic=0
make_relative=0

HARD_TARGET_MODE_PHYSICAL=0
HARD_TARGET_MODE_LOGICAL=1
hard_target_mode=$HARD_TARGET_MODE_PHYSICAL

use_sudo=0
use_interactive=0
use_force=0
is_verbose=0

ask_for_replace() {
  local dst=$1 answer
  printf "ln: replace '%s'? " "$dst" >&2
  IFS= read -r answer || return 1
  case "${answer,,}" in
    y|yes) return 0 ;;
    *)     return 1 ;;
  esac
}

prepare_destination() {
  local dst=$1 method

  # If the path doesn't already exist, we don't have to do anything.
  path_exists "$dst" || return 0

  if (( use_interactive )); then
    ask_for_replace "$dst" || return 1
  fi
  if (( backup_enabled )); then
    method=`backup_method "$backup_control"` || return 1
    if [[ $method != none ]]; then
      make_backup "$dst"
      return $?
    fi
  fi
  if (( (! use_force) && (! use_interactive) )); then
    warn "cannot create link '$dst': file exists"
    return 1
  fi

  # The destination must be removed.

  # Never recursively remove a real directory. A symlink-to-directory is a link
  # object and is removable with rm -f.
  if [[ -d $dst && ! -L $dst ]]; then
    warn "cannot remove '$dst': is a directory"
    return 1
  fi
  if ! rm -f -- "$dst" 2>/dev/null; then
    warn "cannot remove '$dst'"
    return 1
  fi
}

# Calls Windows' mlink command via cmd.exe.
run_mklink() {
  local kind=$1
  local win_link=`to_win_path "$2"` || return 1
  local win_target=`to_win_path "$3"` || return 1

  local output=`cmd.exe //c mklink $kind "$win_link" "$win_target" 2>&1`
  local status=$?

  if (( status )) || [[ ! $output =~ '<<===>>' ]];
    then warn "cannot create link '$dst': insufficient privileges to perform this operation"
    else printf '%s' "${output//$'\r'/}"
  fi

  return $status
}

create_link() {
  local original_target=$1
  local target=$1
  local dst=$2

  local status output

  if [[ -z $target ]]; then
    warn "cannot create link '$dst' from an empty target"
    return 1
  fi

  local win_link win_target
  local hard_symlink_text=''

  # Hard link (default).
  if (( ! is_symbolic )); then
    # GNU ln requires hard-link targets to exist.
    if ! path_exists "$target"; then
      warn "cannot create hard link '$dst': target '$target' does not exist"
      return 1
    fi

    if (( hard_target_mode == HARD_TARGET_MODE_LOGICAL )) && [[ -L $target ]]; then
      target=`readlink -f -- "$target" 2>/dev/null` || {
        warn "cannot dereference '$target'"
        return 1
      }
    elif (( hard_target_mode == HARD_TARGET_MODE_PHYSICAL )) && [[ -L $target ]]; then
      # Windows cannot normally make a hard link to a symbolic-link reparse
      # point. Store the link text so we can execute GNU's documented fallback
      # of reproducing the symbolic link if /H is rejected.
      hard_symlink_text=`readlink -- "$target" 2>/dev/null` || {
        warn "cannot read symbolic link '$target'"
        return 1
      }
    fi

    kind='//H'
    if [[ -n $hard_symlink_text ]]; then
      target="$hard_symlink_text"
    fi
  # Symbolic link.
  else
    # mklink uses /D only for directory symbolic links. It otherwise creates
    # a file symbolic link. A non-existent target therefore cannot be inferred
    # as a future directory link; this is an inherent mklink limitation.
    kind=''
    [[ -d $target ]] && kind='//D'

    if (( make_relative )); then
      local link_dir=`dirname -- "$dst"`
      local relative_target=`realpath -m --relative-to="$link_dir" -- "$target" 2>/dev/null` || {
        warn "cannot make '$target' relative to '$link_dir'"
        return 1
      }
      target="$relative_target"
    fi
  fi

  win_link=`to_win_path "$dst"` || return 1

  prepare_destination "$dst"
  status=$?
  (( status )) && return 1

  output=`run_mklink "$kind" "$dst" "$target"`
  status=$?

  # Approximate GNU ln -P fallback on Windows: when the source is a symbolic
  # link and /H is rejected, recreate a symbolic link with identical link text.
  if (( status != 0 )) && [[ -n $hard_symlink_text ]]; then
    local fallback_kind=''
    [[ -d $original_target ]] && fallback_kind='/D'
    output=`run_mklink "$fallback_kind" "$dst" "$target"`
    status=$?
  fi

  if (( status != 0 )); then
    if [[ -n $output ]]; then
      warn "cannot create link '$dst' -> '$original_target': $output"
    else
      warn "cannot create link '$dst' -> '$original_target'"
    fi
    return 1
  fi

  (( is_verbose )) && printf "'%s' -> '%s'\n" "$dst" "$original_target"
}

# ******************************************************************************
#  ARGUMENT PARSER
# ******************************************************************************

target_directory=''
no_dereference=0

operands=()
while [[ $# -gt 0 ]]; do
  arg=$1
  shift
  case $arg in
    --)
      operands+=("$@")
      break
      ;;
    --help)
      show_help
      exit 0
      ;;
    --version)
      show_version
      exit 0
      ;;
    --backup)
      backup_enabled=1
      backup_control=$vc_default
      ;;
    --backup=*)
      backup_enabled=1
      backup_control=${arg#*=}
      ;;
    --directory)
      die "directory hard links are not supported by mklink on Windows"
      ;;
    --force)
      use_force=1
      ;;
    --interactive)
      use_interactive=1
      ;;
    --logical)
      hard_target_mode=$HARD_TARGET_MODE_LOGICAL
      ;;
    --no-dereference)
      no_dereference=1
      ;;
    --physical)
      hard_target_mode=$HARD_TARGET_MODE_PHYSICAL
      ;;
    --relative)
      make_relative=1
      ;;
    --symbolic)
      is_symbolic=1
      ;;
    --suffix=*)
      suffix=${arg#*=}
      ;;
    --suffix)
      [[ $# -gt 0 ]] || die "option '--suffix' requires an argument"
      suffix=$1
      shift
      ;;
    --sudo)
      command -v sudo >/dev/null 2>&1 || die 'sudo was not found'
      use_sudo=1
      ;;
    --target-directory=*)
      target_directory=${arg#*=}
      ;;
    --target-directory)
      [[ $# -gt 0 ]] || die "option '--target-directory' requires an argument"
      target_directory=$1
      shift
      ;;
    --no-target-directory)
      no_target_directory=1
      ;;
    --verbose)
      is_verbose=1
      ;;
    # Support for shorthand arguments that are clustered together.
    -[!-]*)
      cluster=${arg#-}
      while [[ -n $cluster ]]; do
        c=${cluster:0:1}
        cluster=${cluster:1}
        case $c in
          b) backup_enabled=1; backup_control=$vc_default ;;
          d|F) die "directory hard links are not supported by mklink on Windows" ;;
          f) use_force=1 ;;
          i) use_interactive=1 ;;
          L) hard_target_mode=$HARD_TARGET_MODE_LOGICAL ;;
          n) no_dereference=1 ;;
          P) hard_target_mode=$HARD_TARGET_MODE_PHYSICAL ;;
          r) make_relative=1 ;;
          s) is_symbolic=1 ;;
          T) no_target_directory=1 ;;
          v) is_verbose=1 ;;
          S)
            if [[ -n $cluster ]]; then
              suffix=$cluster
              cluster=''
            else
              [[ $# -gt 0 ]] || die "option '-S' requires an argument"
              suffix=$1
              shift
            fi
            ;;
          t)
            if [[ -n $cluster ]]; then
              target_directory=$cluster
              cluster=''
            else
              [[ $# -gt 0 ]] || die "option '-t' requires an argument"
              target_directory=$1
              shift
            fi
            ;;
          *)
            die "invalid option -- '$c'"
            ;;
        esac
      done
      ;;
    -)
      operands+=("$arg")
      ;;
    -*)
      die "invalid option '$arg'"
      ;;
    *)
      operands+=("$arg")
      ;;
  esac
done

if (( make_relative && is_symbolic == 0 )); then
  die "option --relative requires --symbolic"
fi

if [[ -n $target_directory && $no_target_directory -eq 1 ]]; then
  die "cannot combine --target-directory and --no-target-directory"
fi

if (( backup_enabled )) && ! backup_method "$backup_control" >/dev/null 2>&1; then
  die "invalid backup method '$backup_control'"
fi

# ******************************************************************************

declare -a targets=()
declare -a destinations=()

if [[ -n $target_directory ]]; then
  (( ${#operands[@]} >= 1 )) || show_help && exit 1
  [[ -d $target_directory ]] || die "target directory '$target_directory' is not a directory"

  for target in "${operands[@]}"; do
    targets+=("$target")
    destinations+=("$target_directory/$(basename -- "$target")")
  done
else
  case ${#operands[@]} in
    0)
      show_help
      exit 1
      ;;
    1)
      target=${operands[0]}
      targets+=("$target")
      destinations+=("$(basename -- "$target")")
      ;;
    2)
      target=${operands[0]}
      link_name=${operands[1]}
      if (( !no_target_directory && !no_dereference )) && [[ -d $link_name ]]; then
        targets+=("$target")
        destinations+=("$link_name/$(basename -- "$target")")
      else
        targets+=("$target")
        destinations+=("$link_name")
      fi
      ;;
    *)
      directory=${operands[-1]}
      if (( !no_target_directory && !no_dereference )) && [[ -d $directory ]]; then
        for ((i=0; i<${#operands[@]}-1; i++)); do
          target=${operands[i]}
          targets+=("$target")
          destinations+=("$directory/$(basename -- "$target")")
        done
      else
        die "target '$directory' is not a directory"
      fi
      ;;
  esac
fi

final_status=0
for ((i=0; i<${#targets[@]}; i++)); do
  create_link "${targets[i]}" "${destinations[i]}" || final_status=1
done

exit $final_status
